{
  "manifest_version": 3,
  "name": "SEO Lens — تحلیلگر سئو با هایلایت",
  "version": "1.0.0",
  "description": "مشکلات سئوی هر صفحه را پیدا می‌کند و اون بخشی که مشکل دارد را روی صفحه هایلایت می‌کند.",
  "homepage_url": "https://github.com/hassan95eb/seo-extension",
  "default_locale": "fa",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SEO Lens — تحلیل این صفحه",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "audit.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
